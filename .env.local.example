# ---- Supabase -------------------------------------------------------------
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side only. NEVER commit this and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- LLM (Google Gemini) --------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_key_here

# Chat: 0.94s to first token with thinking disabled, comfortably inside the
# p50 < 1s budget. Classifier: flash-lite, ~0.85s, runs on every message.
# Verified 2026-09-01 against this key. Note gemini-2.5-* are closed to new
# users and gemini-3-flash-preview took 15-48s, which is unusable here.
CHAT_MODEL=gemini-3.5-flash
RISK_MODEL=gemini-3.5-flash-lite

# IMPLEMENTATION NOTE: flash-lite REJECTS thinkingConfig with HTTP 400.
# Send thinkingConfig only to CHAT_MODEL, never to RISK_MODEL.

# PDPA s.129 - KNOWN LIMITATION, documented in the brief rather than hidden.
# The AI Studio endpoint (generativelanguage.googleapis.com) accepts no region
# parameter, so this value is aspirational: it records where processing SHOULD
# happen and is read by the code so that moving to Vertex AI is a config change.
# Production would use Vertex AI in asia-southeast1. Redaction and the consent
# gate remain in force regardless.
LLM_REGION=asia-southeast1

# ---- Timeouts (ms) — see PLANNING.md §11 ----------------------------------
# Every failure fails toward safety and honesty, never toward silence.
REDACTION_TIMEOUT_MS=2000
RISK_CLASSIFY_TIMEOUT_MS=3000
CHAT_TIMEOUT_MS=10000

# ---- Channels -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
