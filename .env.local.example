# ---- Supabase -------------------------------------------------------------
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side only. NEVER commit this and never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---- LLM ------------------------------------------------------------------
# PDPA s.129: the endpoint region is a LEGAL decision, not a latency one.
# Bedrock ap-southeast-1 (Singapore) makes the "substantially similar law" limb
# arguable; a US endpoint makes it fail outright. See research/report-E §6.
LLM_REGION=ap-southeast-1
ANTHROPIC_API_KEY=your_key_here

CHAT_MODEL=claude-sonnet-5
RISK_MODEL=claude-haiku-4-5-20251001

# ---- Timeouts (ms) — see PLANNING.md §11 ----------------------------------
# Every failure fails toward safety and honesty, never toward silence.
REDACTION_TIMEOUT_MS=2000
RISK_CLASSIFY_TIMEOUT_MS=3000
CHAT_TIMEOUT_MS=10000

# ---- Channels -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
